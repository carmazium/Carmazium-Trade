// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

/**
 * How a dealer's business is constituted. Drives which KYC evidence we ask for:
 * a limited company has a VAT number and a Companies House record; a sole trader
 * has neither, and proves themselves with photo ID plus proof of address.
 */
enum BusinessType {
  PRIVATE_LIMITED
  SOLE_PROPRIETORSHIP

  @@map("business_type")
}

enum UserRole {
  ADMIN
  BUYER
  SELLER
  DEALER
  CONTRACTOR
  FINANCE_PARTNER
  INSURANCE_PARTNER

  @@map("user_role")
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  PLUGIN_HYBRID
  HYDROGEN_CELL
  BI_FUEL
  NATURAL_GAS
  PETROL_HYBRID
  DIESEL_HYBRID
  PETROL_PLUGIN_HYBRID
  DIESEL_PLUGIN_HYBRID
  UNLISTED

  @@map("fuel_type")
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  SEMI_AUTOMATIC

  @@map("transmission_type")
}

enum ListingType {
  AUCTION
  CLASSIFIED

  @@map("listing_type")
}

enum VehicleType {
  CAR
  HGV
  MOTORCYCLE

  @@map("vehicle_type")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  OFFER_ACCEPTED
  SOLD
  WITHDRAWN
  REJECTED

  @@map("listing_status")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  COUNTERED

  @@map("offer_status")
}

enum ServiceStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_status")
}

enum TransactionType {
  DEPOSIT
  FULL_PAYMENT
  COMMISSION
  REFUND
  HPI_REPORT
  HPI_REPORT_EMAIL
  LISTING_FEE
  BOOST

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@map("transaction_status")
}

enum FinanceApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED

  @@map("finance_application_status")
}

enum InsuranceQuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  EXPIRED
  REJECTED

  @@map("insurance_quote_status")
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  CONVERTIBLE
  ESTATE
  CROSSOVER
  SPORTS_CAR
  MINIVAN
  PICKUP_TRUCK
  STATION_WAGON
  MPV
  VAN

  @@map("body_type")
}

/// Standard condition + UK insurance write-off categories
enum VehicleCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  /// Structural damage, repaired — can be re-registered
  CAT_S
  /// Non-structural damage, repaired — can be re-registered
  CAT_N
  /// Structural damage, not repaired — cannot be re-registered
  CAT_C
  /// Non-structural damage, not repaired — cannot be re-registered
  CAT_D

  @@map("vehicle_condition")
}

/// Insurance write-off category — separate from general vehicle condition
enum WriteOffCategory {
  NONE  /// Not a write-off
  CAT_S /// Structural damage, repaired — can be re-registered; retail & auction
  CAT_N /// Non-structural damage, repaired — can be re-registered; retail & auction
  CAT_A /// Structural write-off, cannot be re-registered — AUCTION ONLY
  CAT_B /// Body salvage only, cannot be re-registered — AUCTION ONLY

  @@map("write_off_category")
}

/// European emission standards relevant to UK ULEZ/CAZ zones
enum EuroStandard {
  EURO_4
  EURO_5
  EURO_6
  EURO_6D

  @@map("euro_standard")
}

/// Dealer staff roles for RBAC within a dealership
enum DealerRole {
  ADMIN
  SALES_AGENT
  FINANCE_MANAGER

  @@map("dealer_role")
}

/// CRM lead pipeline statuses
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATING
  WON
  LOST

  @@map("lead_status")
}

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED

  @@map("auction_status")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("kyc_status")
}

/// Post-sale handover pipeline status for dealer purchases
enum PurchaseStatus {
  AWAITING_CONFIRMATION
  REVIEWING_DOCS
  CHECKS_COMPLETE
  DELIVERY_REQUESTED

  @@map("purchase_status")
}

/// Phase 15: Delivery request lifecycle
enum DeliveryStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED

  @@map("delivery_status")
}


// ============================================================================
// USER MANAGEMENT & PROFILES
// ============================================================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            UserRole  @default(BUYER)
  firstName       String?
  lastName        String?
  phone           String?
  profileImage    String?
  isEmailVerified  Boolean   @default(false)
  isPhoneVerified  Boolean   @default(false)
  isAddressVerified Boolean  @default(false)
  addressVerifiedAt DateTime?
  loginAttempts    Int       @default(0)
  lockoutUntil     DateTime?
  stripeCustomerId               String?   @unique
  stripeConnectAccountId         String?   @unique
  stripeConnectOnboardingComplete Boolean  @default(false)
  bankAccountName               String?
  bankSortCode                  String?
  bankAccountNumber             String?
  payoutPreference              String?   @default("STRIPE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  dealerProfile           DealerProfile?
  dealerStaffMemberships  DealerStaff[]
  contractorProfile       ContractorProfile?
  financePartnerProfile   PartnerProfile?      @relation("FinancePartner")
  insurancePartnerProfile PartnerProfile?      @relation("InsurancePartner")
  sellerProfile           SellerProfile?
  listings                Listing[]
  bids                    Bid[]
  serviceRequests         ServiceRequest[]
  financeApplications     FinanceApplication[]
  insuranceQuotes         InsuranceQuote[]
  transactions            Transaction[]
  chatRoomsAsInitiator    ChatRoom[]           @relation("Initiator")
  chatRoomsAsParticipant  ChatRoom[]           @relation("Participant")
  messages                Message[]
  notifications           Notification[]
  watchlistItems          WatchlistItem[]
  sellerReviewsGiven      SellerReview[]       @relation("ReviewerRelation")
  analyticsEvents         AnalyticsEvent[]
  featuredBoosts          FeaturedBoost[]
  offers                  Offer[]
  addressVerifications    AddressVerification[]
  assignedLeads           Lead[]               @relation("AssignedAgent")
  salesAsSeller           Sale[]               @relation("SellerSales")
  purchasesAsBuyer        Sale[]               @relation("BuyerPurchases")
  offersReceived          Offer[]              @relation("SellerOffers")
  wonAuctions             Auction[]            @relation("AuctionWinner")
  deliveryRequestsAsBuyer  DeliveryRequest[] @relation("DeliveryBuyer")
  deliveryRequestsAsSeller DeliveryRequest[] @relation("DeliverySeller")
  hpiReportsPrepared       HpiReport[]       @relation("HpiReportsPrepared")
  hpiReportEmailRequests   HpiReportEmailRequest[] @relation("HpiReportEmailRequests")

  notifyOnSale    Boolean @default(true)
  showPublicProfile Boolean @default(true)
  location        String?
  postcode        String?
  preferences     Json?

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ============================================================================
// SELLER PROFILES & REVIEWS
// ============================================================================

model SellerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  /// Weighted 0–5.0 score: (avgRating * 0.5) + (responseRate * 0.3) + (salesRatio * 0.2)
  reliabilityScore Float    @default(0)
  totalSales       Int      @default(0)
  totalListings    Int      @default(0)
  /// Percentage (0–100) of buyer enquiries responded to within 48 hours
  responseRate     Float    @default(0)
  /// Average hours to first response; null until first interaction recorded
  avgResponseHours Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews SellerReview[]

  @@index([userId])
  @@index([reliabilityScore])
  @@map("seller_profiles")
}

model SellerReview {
  id         String   @id @default(uuid())
  /// References SellerProfile.id (not User.id)
  sellerId   String
  reviewerId String
  listingId  String?
  /// 1–5 star rating
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer      User          @relation("ReviewerRelation", fields: [reviewerId], references: [id])

  @@unique([sellerId, reviewerId, listingId])
  @@index([sellerId])
  @@index([reviewerId])
  @@map("seller_reviews")
}

model DealerProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  companyName        String
  vatNumber          String    @unique
  registrationNumber String?
  businessAddress    String?
  /// Dealership logo URL
  logo               String?
  /// Short description / tagline
  description        String?
  /// Contact phone number
  phone              String?
  /// Dealership website URL
  website            String?
  /// JSON object for opening hours, e.g. {"mon":"9-5","tue":"9-5",...}
  openingHours       Json?
  isVerified         Boolean   @default(false)
  verificationDate   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff DealerStaff[]
  leads Lead[]
  invites DealerInvite[]
  kyc   DealerKyc?

  @@index([userId])
  @@map("dealer_profiles")
}

model DealerKyc {
  id                         String        @id @default(uuid())
  dealerProfileId            String        @unique
  // Existing rows predate this column and are all limited companies, so the
  // default backfills them correctly.
  businessType               BusinessType  @default(PRIVATE_LIMITED)
  companyHouseName           String
  representativeName         String
  representativePosition     String
  vatNumber                  String
  vatProof                   String?       // Optional URL to stored VAT proof image
  companyRegistrationNumber  String
  companyRegistrationProof   String?       // Optional URL to stored Company House cert
  personOfSignificantControl String
  directorName               String
  directorIdProof            String?       // Optional URL to stored Director ID photo
  proofOfAddress             String?       // Sole traders only — utility bill / bank statement
  businessWebsite            String
  businessRegisteredAddress  String
  tradingAddress             String?
  googleReviewsLink          String?
  paymentReference           String?
  paymentScreenshot          String?       // Optional URL to stored image
  stripePaymentIntentId      String?       // Populated after confirmed £1 KYC charge
  stripeCheckoutSessionId    String?       @unique // Stripe Checkout Session ID, for webhook reconciliation
  stripeChargedAt            DateTime?     // Timestamp of confirmed charge
  status                     KycStatus     @default(PENDING)
  documentStatuses           Json?         // Granular field status: Map of field name to { status: KycStatus, note: string }
  submittedAt                DateTime      @default(now())
  reviewedAt                 DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  dealerProfile              DealerProfile @relation(fields: [dealerProfileId], references: [id], onDelete: Cascade)

  @@index([dealerProfileId])
  @@index([status])
  @@map("dealer_kycs")
}


model DealerInvite {
  id              String     @id @default(uuid())
  email           String
  dealerProfileId String
  role            DealerRole @default(SALES_AGENT)
  token           String     @unique
  expiresAt       DateTime
  createdAt       DateTime   @default(now())

  dealerProfile DealerProfile @relation(fields: [dealerProfileId], references: [id], onDelete: Cascade)

  @@unique([email, dealerProfileId])
  @@index([dealerProfileId])
  @@index([email])
  @@map("dealer_invites")
}

/// Staff members belonging to a dealership, with RBAC roles
model DealerStaff {
  id              String     @id @default(uuid())
  userId          String
  dealerProfileId String
  role            DealerRole @default(SALES_AGENT)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealerProfile DealerProfile @relation(fields: [dealerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, dealerProfileId])
  @@index([userId])
  @@index([dealerProfileId])
  @@map("dealer_staff")
}

/// CRM lead tracking for dealerships
model Lead {
  id              String     @id @default(uuid())
  dealerProfileId String
  listingId       String?
  /// Sales agent assigned to this lead
  assignedToId    String?
  buyerName       String
  buyerEmail      String?
  buyerPhone      String?
  status          LeadStatus @default(NEW)
  /// Source of the lead: listing_enquiry, chat, offer, walk_in, phone
  source          String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  dealerProfile DealerProfile @relation(fields: [dealerProfileId], references: [id], onDelete: Cascade)
  listing       Listing?      @relation(fields: [listingId], references: [id])
  assignedTo    User?         @relation("AssignedAgent", fields: [assignedToId], references: [id])

  @@index([dealerProfileId])
  @@index([assignedToId])
  @@index([status])
  @@index([listingId])
  @@map("leads")
}

model ContractorProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  serviceTypes   String[] // e.g., ["Detailing", "Mechanic", "Pre-purchase Inspection"]
  rating         Float     @default(0)
  totalReviews   Int       @default(0)
  serviceArea    String? // e.g., "London, UK" or JSON for coordinates
  certifications String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([userId])
  @@map("contractor_profiles")
}

model PartnerProfile {
  id              String    @id @default(uuid())
  financeUserId   String?   @unique
  insuranceUserId String?   @unique
  partnerType     UserRole // FINANCE_PARTNER or INSURANCE_PARTNER
  companyName     String
  apiKey          String    @unique
  callbackUrl     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  financeUser         User?                @relation(fields: [financeUserId], references: [id], onDelete: Cascade, name: "FinancePartner")
  insuranceUser       User?                @relation(fields: [insuranceUserId], references: [id], onDelete: Cascade, name: "InsurancePartner")
  financeApplications FinanceApplication[]
  insuranceQuotes     InsuranceQuote[]

  @@map("partner_profiles")
}

// ============================================================================
// VEHICLES & INVENTORY
// ============================================================================

model Vehicle {
  id           String            @id @default(uuid())
  vin          String?           @unique
  vrm          String?           @unique
  make         String
  model        String
  year         Int
  fuelType     FuelType?
  transmission TransmissionType?
  mileage      Int?
  color        String?
  bodyType     String?
  doors        Int?
  seats        Int?
  engineSize   Int? // cc, e.g. 2993
  bhp          Int?
  features     Json? // Array of strings: ["Sunroof", "Heated Seats"]
  metadata     Json? // JSONB for other flexible specs
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  listings Listing[]

  @@index([vin])
  @@index([vrm])
  @@map("vehicles")
}

model Listing {
  id          String        @id @default(uuid())
  vehicleId   String?
  sellerId    String?
  type        ListingType   @default(CLASSIFIED)
  status      ListingStatus @default(DRAFT)
  title       String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  images      String[] // Array of Supabase URLs
  videoUrls   String[] // Optional video embed URLs (YouTube, Instagram, Facebook, X)
  slug        String        @unique
  viewCount   Int           @default(0)
  vehicleType VehicleType   @default(CAR)
  isImported  Boolean       @default(false)

  // Denormalized vehicle fields for simpler queries
  make                     String?
  model                    String?
  year                     Int?
  mileage                  Int?
  vrm                      String?
  fuelType                 FuelType?
  transmission             TransmissionType?
  color                    String?
  doors                    Int?
  seats                    Int?
  engineSize               Int?
  bhp                      Int?
  bodyType                 BodyType?
  features                 Json?
  location                 String?
  latitude                 Float?
  longitude                Float?
  // Phase 3: condition and UK compliance fields
  vin                      String? // VIN (17-char, validated frontend-side)
  condition                VehicleCondition?
  ulezCompliant            Boolean?
  euroStandard             EuroStandard?
  co2Emissions             Int? // CO2 g/km (from DVLA VES API)
  // DVLA extended fields (auto-filled from VES API)
  motStatus                String? // e.g. "Valid", "Not valid"
  taxStatus                String? // e.g. "Taxed", "SORN"
  motExpiryDate            String? // ISO date string
  taxDueDate               String? // ISO date string
  markedForExport          Boolean?
  monthOfFirstRegistration String? // e.g. "2015-03"
  wheelplan                String? // e.g. "2 AXLE RIGID BODY"
  typeApproval             String? // e.g. "M1"
  // Phase 5: Featured boost
  isFeatured               Boolean           @default(false)
  featuredUntil            DateTime?
  // Phase 7: Badge tiers — FREE | STANDARD | PREMIUM
  badgeTier                String            @default("FREE")
  // Phase 6: Offering System — price range
  priceMin                 Decimal?          @db.Decimal(12, 2)
  priceMax                 Decimal?          @db.Decimal(12, 2)
  // Legal declarations — compliance fields (Write-Off & Legal)
  stolenRecovered          Boolean?
  hasOutstandingFinance    Boolean?
  isLegalRegisteredKeeper  Boolean?
  writeOffCategory         WriteOffCategory? @default(NONE)
  // Extended vehicle details (seller-supplied)
  variant                  String?   // Model variant/trim, e.g. "M Sport", "GT Line"
  driveType                String?   // FWD, RWD, AWD, 4WD
  numberOfKeys             Int?      // Number of keys included
  serviceHistory           String?   // Full Main Dealer, Full Independent, Partial, None
  owners                   String?   // Number of previous keepers: "1", "2", "3+"
  isDepartedSale           Boolean?
  departedRelationship     String?
  notOwnerRelationship     String?   // Relationship to the vehicle's legal registered keeper, when the seller is not the keeper
  torqueNm                 Int?      // Torque in Nm
  topSpeedMph              Int?      // Top speed in mph
  zeroTo60Mph              Float?    // 0-60 mph time in seconds
  combinedMpg              Float?    // Combined fuel economy MPG
  extraUrbanMpg            Float?    // Extra urban MPG
  // Exterior grade — 1 (best) to 5 (worst), Motorway-style. Seller-supplied. Rendered on cards.
  exteriorGrade            Int?      @db.SmallInt
  // Attention attribute — buyer-facing label shown as a ribbon on the vehicle card
  bannerLabel              String?

  // Admin review — set when status transitions to/from PENDING_REVIEW
  rejectionReason          String?
  reviewedAt               DateTime?

  // Cross-channel link — set when this listing is simultaneously available in both auction and retail
  linkedListingId String?
  linkedListing   Listing?  @relation("LinkedListing", fields: [linkedListingId], references: [id])
  linkedListings  Listing[] @relation("LinkedListing")

  // Platform import — set when listing was imported from an external marketplace
  importedFromUrl String?
  importedSource  String? // AUTOTRADER | CARGURUS | CARWOW

  // Phase 15: Delivery
  deliveryAvailable       Boolean   @default(false)
  deliveryPricePerMile    Decimal?  @db.Decimal(10, 2)
  deliveryMaxMiles        Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id])
  seller              User?                @relation(fields: [sellerId], references: [id])
  auction             Auction?
  bids                Bid[]
  offers              Offer[]
  featuredBoosts      FeaturedBoost[]
  financeApplications FinanceApplication[]
  insuranceQuotes     InsuranceQuote[]
  transactions        Transaction[]
  chatRooms           ChatRoom[]
  watchlistItems      WatchlistItem[]
  leads               Lead[]
  damageRecords       DamageRecord[]
  sale                Sale?
  hpiReport           HpiReport?
  deliveryRequests    DeliveryRequest[]

  @@index([sellerId])
  @@index([vehicleId])
  @@index([status])
  @@index([slug])
  @@index([isFeatured, status, featuredUntil])
  @@index([createdAt])
  @@map("listings")
}

// ============================================================================
// HPI REPORTS
// ============================================================================

/// A report is created the moment the seller pays, in PENDING state with no
/// data — an admin then either fills in the check results (generating the
/// branded PDF) or uploads the supplied PDF directly, which flips it to
/// COMPLETED. A PENDING report does NOT hold up the listing: it can be
/// published and even sell first, with the report attached later.
/// Rows predating that change were
/// auto-generated from OneAutoAPI and are already COMPLETED/ONE_AUTO_API by
/// virtue of the column defaults, so they keep rendering from `data` as before.
model HpiReport {
  id              String   @id @default(uuid())
  listingId       String   @unique
  vrm             String
  /// Raw OneAutoAPI response. Only ever populated on legacy ONE_AUTO_API rows.
  data            Json?
  isClear         Boolean  @default(false)
  purchasedAt     DateTime @default(now())
  transactionId   String?  // Reference to payment transaction

  status          HpiReportStatus @default(COMPLETED)
  source          HpiReportSource @default(ONE_AUTO_API)
  /// Structured check data entered by an admin, rendered into the PDF.
  /// Shape is owned by HpiReportData in backend/src/hpi/hpi-report.types.ts.
  reportData      Json?
  /// An admin can instead upload the third-party PDF wholesale. Stored in-row
  /// rather than object storage on purpose: a report is paid content, so there
  /// must be no URL that can be fetched without passing our own auth. When
  /// this is set it takes precedence over `reportData` when serving the PDF.
  pdfData         Bytes?
  pdfFileName     String?
  pdfSizeBytes    Int?
  pdfUploadedAt   DateTime?
  preparedById    String?
  preparedAt      DateTime?
  /// Last time admins were nudged about this report still being outstanding.
  /// Dedupes the reminder job so one stale report can't mail them daily.
  reminderSentAt  DateTime?

  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  preparedBy      User?    @relation("HpiReportsPrepared", fields: [preparedById], references: [id], onDelete: SetNull)

  emailRequests   HpiReportEmailRequest[]

  @@index([listingId])
  @@index([status])
  @@map("hpi_reports")
}

enum HpiReportStatus {
  PENDING
  COMPLETED

  @@map("hpi_report_status")
}

enum HpiReportSource {
  ONE_AUTO_API
  ADMIN

  @@map("hpi_report_source")
}

/// A buyer's paid request to have the vehicle history report emailed to them
/// personally. Deliberately separate from HpiReport itself — payment and
/// delivery are decoupled in time (a buyer can pay before the report exists),
/// and many buyers can each pay for their own copy of the same underlying
/// report, so this is a fan-out list, not a 1:1 field on HpiReport.
model HpiReportEmailRequest {
  id            String                   @id @default(uuid())
  hpiReportId   String
  buyerId       String
  /// Snapshot of the buyer's account email at request time — never taken
  /// from client input, and a later email change on the account shouldn't
  /// silently redirect an already-queued delivery.
  buyerEmail    String
  transactionId String?
  status        HpiEmailDeliveryStatus  @default(PENDING)
  requestedAt   DateTime                @default(now())
  sentAt        DateTime?

  hpiReport     HpiReport @relation(fields: [hpiReportId], references: [id], onDelete: Cascade)
  buyer         User      @relation("HpiReportEmailRequests", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([hpiReportId])
  @@index([buyerId])
  @@index([status])
  @@map("hpi_report_email_requests")
}

enum HpiEmailDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("hpi_email_delivery_status")
}

// ============================================================================
// AUCTION ENGINE
// ============================================================================

model Auction {
  id               String        @id @default(uuid())
  listingId        String        @unique
  startTime        DateTime
  endTime          DateTime
  reservePrice     Decimal       @db.Decimal(12, 2)
  startingBid      Decimal       @db.Decimal(12, 2)
  minIncrement     Decimal       @db.Decimal(12, 2)
  status           AuctionStatus @default(SCHEDULED)
  winnerId         String?
  winningBidAmount Decimal?      @db.Decimal(12, 2)

  // Buy It Now fields
  buyItNowPrice          Decimal?  @db.Decimal(12, 2)
  buyItNowPendingBuyerId String?
  buyItNowPendingAt      DateTime?

  // Buyer fee & handover tracking
  // Set the moment a winner is determined (real bid, BIN, seller-accept, or
  // admin assignment). Used to measure the grace window before an unpaid win
  // auto-reverts — see UnpaidAuctionFeeExpiryService.
  wonAt                  DateTime?
  buyerFeePaid           Boolean   @default(false)
  buyerFeeTransactionId  String?
  handoverProofUrl       String?
  handoverSubmittedAt    DateTime?
  sellerBonusReleased    Boolean   @default(false)
  sellerBonusReleasedAt  DateTime?
  stripePayoutTransferId String?   // Set when Stripe transfer succeeds
  stripePayoutError      String?   // Set when auto-payout didn't happen (no Connect account, Stripe error, or test-mode skip) — needs manual action
  stripeRefundError      String?   // Set if the buyer-fee refund fails on handover denial — needs manual action
  // Set once an admin manually confirms they've paid the seller outside Stripe
  // (bank transfer). sellerBonusReleased means "handover approved" — this is
  // the separate "the £100 has actually reached the seller" signal; without
  // it, an approved-but-unpaid auction had no way to ever be marked resolved.
  manualPayoutConfirmedAt DateTime?

  // Digest — seller-authored custom tags/batch labels and self-rating for their own auction
  customTags       String[] @default([])
  sellerSelfRating Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  winner  User?   @relation("AuctionWinner", fields: [winnerId], references: [id])

  @@index([status])
  @@index([endTime])
  @@index([startTime])
  @@map("auctions")
}

model Bid {
  id        String    @id @default(uuid())
  listingId String
  bidderId  String
  amount    Decimal   @db.Decimal(12, 2)
  timestamp DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  cancelledAt DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@index([listingId, amount(sort: Desc)])
  @@index([bidderId])
  @@index([bidderId, createdAt(sort: Desc)])
  @@map("bids")
}

// ============================================================================
// SERVICES & INTEGRATIONS
// ============================================================================

model ServiceRequest {
  id            String        @id @default(uuid())
  contractorId  String
  requesterId   String
  listingId     String?
  serviceType   String
  status        ServiceStatus @default(PENDING)
  description   String?
  quotedPrice   Decimal?      @db.Decimal(12, 2)
  acceptedPrice Decimal?      @db.Decimal(12, 2)
  scheduledDate DateTime?
  completedDate DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  contractor ContractorProfile @relation(fields: [contractorId], references: [id])
  requester  User              @relation(fields: [requesterId], references: [id])

  @@index([contractorId])
  @@index([requesterId])
  @@index([status])
  @@map("service_requests")
}

model FinanceApplication {
  id             String                   @id @default(uuid())
  listingId      String
  userId         String
  partnerId      String
  depositAmount  Decimal                  @db.Decimal(12, 2)
  termMonths     Int
  monthlyPayment Decimal?                 @db.Decimal(12, 2)
  status         FinanceApplicationStatus @default(PENDING)
  approvalDate   DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  listing Listing        @relation(fields: [listingId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  partner PartnerProfile @relation(fields: [partnerId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@map("finance_applications")
}

model InsuranceQuote {
  id             String               @id @default(uuid())
  listingId      String
  userId         String
  partnerId      String
  coverageType   String?
  quotedPrice    Decimal?             @db.Decimal(12, 2)
  status         InsuranceQuoteStatus @default(PENDING)
  driverAge      Int
  ncbYears       Int
  hasConvictions Boolean              @default(false)
  expiryDate     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  listing Listing        @relation(fields: [listingId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  partner PartnerProfile @relation(fields: [partnerId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@index([partnerId])
  @@map("insurance_quotes")
}

// ============================================================================
// TRANSACTIONS & MESSAGING
// ============================================================================

model Transaction {
  id              String            @id @default(uuid())
  listingId       String
  userId          String
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  stripePaymentId String?           @unique
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
  @@index([status])
  @@map("transactions")
}

model ChatRoom {
  id            String    @id @default(uuid())
  initiatorId   String
  participantId String
  listingId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  initiator   User      @relation("Initiator", fields: [initiatorId], references: [id])
  participant User      @relation("Participant", fields: [participantId], references: [id])
  listing     Listing?  @relation(fields: [listingId], references: [id])
  messages    Message[]

  @@unique([initiatorId, participantId])
  @@index([initiatorId])
  @@index([participantId])
  @@map("chat_rooms")
}

model Message {
  id         String    @id @default(uuid())
  chatRoomId String
  senderId   String
  content    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId])
  @@index([senderId])
  @@index([chatRoomId, createdAt(sort: Desc)])
  @@map("messages")
}

// ============================================================================
// WATCHLIST
// ============================================================================

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  // Idempotency guard for the "auction ends in 24h" reminder
  reminded24hAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("watchlist_items")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String // BID_PLACED, AUCTION_ENDING, MESSAGE_RECEIVED, etc.
  title      String
  message    String
  data       Json? // Contextual data (listingId, bidId, etc.)
  
  // Deep-linking fields
  entityType String?  // e.g. "LISTING", "OFFER"
  entityId   String?  // UUID
  actionType String?  // e.g. "COUNTER_RECEIVED"

  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// ============================================================================
// ANALYTICS & LEAD GENERATION
// ============================================================================

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String // page_view, search, listing_view, filter_apply, login_wall_hit, enquiry
  payload   Json     @default("{}")
  sessionId String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}

model EmailCapture {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String // auctions_coming_soon, newsletter, mazium_widget
  createdAt DateTime @default(now())

  @@index([source])
  @@map("email_captures")
}

// ============================================================================
// FEATURED BOOST
// ============================================================================

model FeaturedBoost {
  id              String   @id @default(uuid())
  listingId       String
  sellerId        String
  stripeSessionId String?  @unique
  stripePaymentId String?  @unique
  amountPaid      Decimal  @default(25.00) @db.Decimal(10, 2)
  currency        String   @default("gbp")
  boostedAt       DateTime @default(now())
  expiresAt       DateTime
  isActive        Boolean  @default(false)
  bypassed        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller  User    @relation(fields: [sellerId], references: [id])

  @@index([listingId])
  @@index([sellerId])
  @@index([expiresAt])
  @@index([isActive])
  @@map("featured_boosts")
}

// ============================================================================
// OFFERING SYSTEM
// ============================================================================

model Offer {
  id        String      @id @default(uuid())
  listingId String
  buyerId   String
  sellerId  String?
  amount    Decimal     @db.Decimal(12, 2)
  /// Buyer's minimum offer price (lower bound of their range)
  amountMin Decimal?    @db.Decimal(12, 2)
  /// Buyer's maximum offer price (upper bound of their range)
  amountMax Decimal?    @db.Decimal(12, 2)
  status    OfferStatus @default(PENDING)
  /// Optional message from buyer to seller
  message   String?
  
  /// Negotiation Ledger fields
  initialAmount      Decimal?    @db.Decimal(12, 2)
  finalAmount        Decimal?    @db.Decimal(12, 2)
  sellerCounterAmount Decimal?   @db.Decimal(12, 2)
  buyerCounterAmount  Decimal?   @db.Decimal(12, 2)

  /// Keep this for backwards compatibility if needed, or remove it later
  counterAmount Decimal?    @db.Decimal(12, 2)

  counterAttemptsBuyer  Int       @default(0)
  counterAttemptsSeller Int       @default(0)
  counterExpiresAt      DateTime?
  lastCounteredBy       String?   // 'BUYER' | 'SELLER'

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  listing          Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer            User             @relation(fields: [buyerId], references: [id])
  seller           User?            @relation("SellerOffers", fields: [sellerId], references: [id])
  deliveryRequests DeliveryRequest[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([buyerId, status])
  @@map("offers")
}

// ============================================================================
// DELIVERY SYSTEM
// ============================================================================

model DeliveryRequest {
  id               String         @id @default(uuid())
  listingId        String
  offerId          String
  buyerId          String
  sellerId         String
  deliveryAddress  Json           // { street: string, city: string, postcode: string }
  deliveryNotes    String?
  distanceMiles    Float
  estimatedCostGbp Decimal        @db.Decimal(10, 2)
  status           DeliveryStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  declinedAt       DateTime?
  cancelledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offer    Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  buyer    User    @relation("DeliveryBuyer", fields: [buyerId], references: [id])
  seller   User    @relation("DeliverySeller", fields: [sellerId], references: [id])

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([expiresAt])
  @@map("delivery_requests")
}

// ============================================================================
// AI PRICING SYSTEM
// ============================================================================

/// Scraped market price data from competitor websites
model MarketPriceData {
  id           String   @id @default(uuid())
  source       String   // AUTOTRADER, MOTORS, GUMTREE, CARGURUS, CARWOW, PULSECARS
  make         String
  model        String
  variant      String?
  year         Int
  mileage      Int
  price        Decimal  @db.Decimal(12, 2)
  fuelType     String?
  transmission String?
  bodyType     String?
  location     String?
  sellerType   String?  // PRIVATE or DEALER
  sourceUrl    String?
  scrapedAt    DateTime @default(now())

  @@index([make, model, year])
  @@index([make, model])
  @@index([scrapedAt])
  @@map("market_price_data")
}

/// Cached AI price estimates to avoid re-computation
model PriceEstimateCache {
  id           String   @id @default(uuid())
  make         String
  model        String
  year         Int
  mileage      Int
  fuelType     String?
  transmission String?
  condition    String?
  location     String?

  /// Computed values
  estimateLow  Decimal  @db.Decimal(12, 2)
  estimateMid  Decimal  @db.Decimal(12, 2)
  estimateHigh Decimal  @db.Decimal(12, 2)
  comparables  Int      // How many market listings were used
  confidence   Float    // 0.0 - 1.0 confidence score

  createdAt    DateTime @default(now())
  expiresAt    DateTime // 24-48hr TTL

  @@unique([make, model, year, mileage, fuelType, transmission, condition])
  @@index([make, model, year])
  @@index([expiresAt])
  @@map("price_estimate_cache")
}

// Session store for connect-pg-simple (managed by express-session)
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@map("sessions")
}

model DamageRecord {
  id        String   @id @default(uuid())
  listingId String
  part      String   // e.g., "Front Bumper", "Driver Door"
  type      String   // e.g., "Scratch", "Scuff", "Dent"
  size      String   // e.g., "0-5cm", "6-15cm", "15cm+"
  coords    Json     // { x: number, y: number, view: 'FRONT'|'SIDE'|'REAR'|'TOP' }
  imageUrl  String?  // Reference to the source photo
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  @@index([listingId])
  @@map("damage_records")
}

// ============================================================================
// MARKETING POPUP (admin-configurable, singleton row)
// ============================================================================

model MarketingPopup {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(true)
  imageUrl  String?
  linkUrl   String   @default("/auctions")
  updatedAt DateTime @updatedAt
  updatedBy String?  // admin user id who last changed it

  @@map("marketing_popup")
}

// ============================================================================
// BLOG (admin-authored content, markdown body)
// ============================================================================

enum BlogPostStatus {
  DRAFT
  PUBLISHED

  @@map("blog_post_status")
}

model BlogPost {
  id              String         @id @default(uuid())
  slug            String         @unique
  title           String
  excerpt         String
  /// Markdown source, rendered client-side with react-markdown
  content         String
  coverImage      String?
  authorName      String         @default("CarMazium Team")
  tags            String[]       @default([])
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  /// Falls back to `title` when unset
  metaTitle       String?
  /// Falls back to `excerpt` when unset
  metaDescription String?
  /// Keeps the post live at its URL but excludes it from search engine indexing
  noIndex         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// ============================================================================
// SALES RECORDS (Revenue Tracking)
// ============================================================================

model Sale {
  id             String         @id @default(uuid())
  listingId      String         @unique
  sellerId       String
  buyerId        String?
  buyerName      String?
  buyerEmail     String?
  buyerPostcode  String?
  soldPrice      Decimal        @db.Decimal(12, 2)
  purchaseStatus PurchaseStatus @default(AWAITING_CONFIRMATION)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  listing   Listing  @relation(fields: [listingId], references: [id])
  seller    User     @relation("SellerSales", fields: [sellerId], references: [id])
  buyer     User?    @relation("BuyerPurchases", fields: [buyerId], references: [id])

  @@index([sellerId])
  @@index([buyerId])
  @@map("sales")
}

// ============================================================================
// ADDRESS VERIFICATION (Trader/Buyer Protection unlock)
// ============================================================================

model AddressVerification {
  id         String    @id @default(uuid())
  userId     String
  address    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("address_verifications")
}

