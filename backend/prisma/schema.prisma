// ============================================================================
// ADDRESS VERIFICATION (Trader/Buyer Protection unlock)
// ============================================================================

model AddressVerification {
  id         String    @id @default(uuid())
  userId     String
  address    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("address_verifications")
}

// ============================================================================
// TRADE EXCHANGE — SERVICE MARKETPLACE
// ============================================================================
// See docs/TRADE_EXCHANGE_SERVICES.md for the flows, rules and API surface.
//
// Money is in integer pence throughout. The fee split is frozen onto the job
// and the payment at acceptance time, so a later change to the platform rate
// never rewrites what a contractor was promised.

/// A contractor's permission to take work in one service area. One row per
/// contractor per service; admin-approved.
model ContractorCapability {
  id           String           @id @default(uuid())
  contractorId String
  serviceType  ServiceType
  status       CapabilityStatus @default(PENDING)
  appliedAt    DateTime         @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String? /// shown to the contractor on rejection/suspension
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  contractor ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("CapabilityReviewer", fields: [reviewedById], references: [id])

  @@unique([contractorId, serviceType])
  @@index([serviceType, status])
  @@map("contractor_capabilities")
}

/// A piece of work a customer wants done. Any signed-in user can post one.
model ServiceJob {
  id          String           @id @default(uuid())
  customerId  String
  serviceType ServiceType
  /// Recovery = broken-down / non-runner. Same flow, flags the urgency and
  /// tells the contractor to bring a flatbed, not trade plates.
  isRecovery  Boolean          @default(false)
  status      ServiceJobStatus @default(OPEN)
  title       String
  description String?

  // Location. Delivery uses pickup + delivery; inspection uses servicePostcode.
  // Full postcodes are visible to approved contractors (they cannot quote a
  // route without them); the street address is revealed only to the accepted
  // contractor.
  pickupPostcode   String?
  pickupAddress    String?
  deliveryPostcode String?
  deliveryAddress  String?
  servicePostcode  String?
  serviceAddress   String?

  /// When the customer wants it. Null = as soon as possible.
  requestedFor DateTime?
  /// OPEN jobs close automatically at this point if no quote was accepted.
  expiresAt    DateTime

  // Set at acceptance. contractorId is denormalised from the accepted quote so
  // "my assigned jobs" is one indexed query.
  acceptedQuoteId       String?  @unique
  contractorId          String?
  agreedAmountPence     Int?
  platformFeeRate       Decimal? @db.Decimal(5, 4)
  platformFeePence      Int?
  contractorAmountPence Int?

  // Where the job came from, when it came from a purchase (post-purchase hook).
  sourceOfferId   String?
  sourceAuctionId String?

  acceptedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime? /// contractor marked complete
  confirmedAt  DateTime? /// customer confirmed (or auto after 48h)
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer      User                @relation("ServiceJobCustomer", fields: [customerId], references: [id])
  contractor    ContractorProfile?  @relation(fields: [contractorId], references: [id])
  acceptedQuote ServiceQuote?       @relation("AcceptedQuote", fields: [acceptedQuoteId], references: [id])
  sourceOffer   Offer?              @relation(fields: [sourceOfferId], references: [id])
  sourceAuction Auction?            @relation(fields: [sourceAuctionId], references: [id])
  vehicles      ServiceJobVehicle[]
  quotes        ServiceQuote[]
  payment       ServicePayment?

  @@index([customerId, status])
  @@index([contractorId, status])
  @@index([serviceType, status, createdAt])
  @@index([status, expiresAt])
  @@map("service_jobs")
}

/// One vehicle on a job. A multi-car move is one job with several rows — one
/// truck, one price. Inspections have exactly one.
model ServiceJobVehicle {
  id           String  @id @default(uuid())
  jobId        String
  registration String?
  make         String?
  model        String?
  year         Int?
  notes        String? /// "non-runner", "no keys", "low clearance"
  /// Set when the vehicle is a CarMazium listing (post-purchase hook).
  listingId    String?

  job     ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  listing Listing?   @relation(fields: [listingId], references: [id])

  @@index([jobId])
  @@map("service_job_vehicles")
}

/// A contractor's price for a job. One live quote per contractor per job; they
/// update it rather than stacking new ones.
model ServiceQuote {
  id            String             @id @default(uuid())
  jobId         String
  contractorId  String
  /// The account that typed it — the contractor's own user, or later a staff
  /// member acting for them.
  submittedById String
  amountPence   Int
  message       String?
  status        ServiceQuoteStatus @default(ACTIVE)
  validUntil    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  job         ServiceJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contractor  ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  submittedBy User              @relation("ServiceQuoteSubmitter", fields: [submittedById], references: [id])
  acceptedFor ServiceJob?       @relation("AcceptedQuote")

  @@unique([jobId, contractorId])
  @@index([contractorId, status])
  @@map("service_quotes")
}

/// The money on a job. Created at acceptance, one per job. The customer pays
/// the gross to the platform via Stripe Checkout; on confirmed completion the
/// contractor's share is transferred to their Connect account.
model ServicePayment {
  id               String               @id @default(uuid())
  jobId            String               @unique
  customerId       String
  contractorId     String
  grossPence       Int
  platformFeeRate  Decimal              @db.Decimal(5, 4)
  platformFeePence Int
  contractorPence  Int
  status           ServicePaymentStatus @default(PENDING)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeTransferId        String? @unique

  paidAt     DateTime?
  releasedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  job        ServiceJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer   User              @relation("ServicePaymentCustomer", fields: [customerId], references: [id])
  contractor ContractorProfile @relation(fields: [contractorId], references: [id])

  @@index([contractorId, status])
  @@index([status])
  @@map("service_payments")
}