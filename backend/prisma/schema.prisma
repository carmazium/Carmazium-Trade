model Offer {
  id        String      @id @default(uuid())
  listingId String
  buyerId   String
  sellerId  String?
  amount    Decimal     @db.Decimal(12, 2)
  /// Buyer's minimum offer price (lower bound of their range)
  amountMin Decimal?    @db.Decimal(12, 2)
  /// Buyer's maximum offer price (upper bound of their range)
  amountMax Decimal?    @db.Decimal(12, 2)
  status    OfferStatus @default(PENDING)
  /// Optional message from buyer to seller
  message   String?

  /// Negotiation Ledger fields
  initialAmount       Decimal? @db.Decimal(12, 2)
  finalAmount         Decimal? @db.Decimal(12, 2)
  sellerCounterAmount Decimal? @db.Decimal(12, 2)
  buyerCounterAmount  Decimal? @db.Decimal(12, 2)

  /// Keep this for backwards compatibility if needed, or remove it later
  counterAmount Decimal? @db.Decimal(12, 2)

  counterAttemptsBuyer  Int       @default(0)
  counterAttemptsSeller Int       @default(0)
  counterExpiresAt      DateTime?
  lastCounteredBy       String? // 'BUYER' | 'SELLER'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing          Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer            User              @relation(fields: [buyerId], references: [id])
  seller           User?             @relation("SellerOffers", fields: [sellerId], references: [id])
  deliveryRequests DeliveryRequest[]
  serviceJobs      ServiceJob[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([buyerId, status])
  @@map("offers")
}

