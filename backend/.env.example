# CarMazium backend environment template — placeholders only.
# Never commit real secrets.

# ── Database / Supabase ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Authentication / session ────────────────────────────────────────────────
SESSION_SECRET=replace_with_a_long_random_secret

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_or_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Vehicle / mapping integrations ──────────────────────────────────────────
DVLA_API_KEY=YOUR_DVLA_API_KEY
DVLA_API_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
MOT_API_KEY=YOUR_MOT_API_KEY
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
SCRAPINGBEE_API_KEY=YOUR_SCRAPINGBEE_API_KEY

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ── Redis / realtime scaling ────────────────────────────────────────────────
# Leave blank for the single-instance in-memory fallback in local development.
REDIS_URL=

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@carmazium.com
# Optional SMTP fallback when EMAIL_PROVIDER is configured for it.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ── Backup / operations ─────────────────────────────────────────────────────
ADMIN_BACKUP_EMAIL=admin@example.com
HEALTH_SELF_URL=http://localhost:3001

# ── App / CORS ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
