# CarMazium backend environment template
# Copy to .env for local development. Never commit real credentials.

# ── Database / Prisma ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Prefer a direct/non-pooler connection for migrations and Prisma operations.
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Compatibility for code shared with the web app. These are public values.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Authentication / sessions ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Redis / real-time WebSockets ─────────────────────────────────────────────
# Local development may leave this blank. Production should configure Redis
# before running more than one backend machine, otherwise Socket.IO broadcasts
# (including live auction bids) cannot fan out between machines.
REDIS_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
# gmail = primary SMTP transport; resend can be selected explicitly instead.
EMAIL_PROVIDER=gmail
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Optional fallback provider when Gmail is primary.
RESEND_API_KEY=
EMAIL_FROM=CarMazium <noreply@carmazium.com>
PUBLIC_SUPPORT_EMAIL=support@carmazium.com
ADMIN_BACKUP_EMAIL=

# ── Vehicle data ──────────────────────────────────────────────────────────────
DVLA_API_KEY=
# Optional; omit to use the production VES endpoint built into the service.
DVLA_API_URL=
MOT_API_KEY=

# ── Maps / delivery ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Market scraping (optional) ───────────────────────────────────────────────
SCRAPINGBEE_API_KEY=

# ── Trade Exchange service marketplace ──────────────────────────────────────
# 0.09 = 9% platform fee on optional service jobs such as delivery/recovery.
SERVICE_PLATFORM_FEE_RATE=0.09

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
# Compatibility fallback used by a few payment redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# Terminus health checks ping a non-recursive application endpoint; do not point
# this at /health because that would recursively invoke the health check itself.
HEALTH_SELF_URL=http://localhost:8080/api

# IMPORTANT
# Production schema changes must be applied with reviewed migrations.
# Never add `prisma db push --accept-data-loss` to a deploy/release command.
