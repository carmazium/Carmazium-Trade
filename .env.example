# CarMazium frontend environment template
# Copy to .env.local for local development. NEXT_PUBLIC_* values are public.

# Application / backend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Search-engine ownership verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics / advertising (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GADS_LABEL_PURCHASE=
NEXT_PUBLIC_GADS_LABEL_LISTING_SUBMITTED=
NEXT_PUBLIC_GADS_LABEL_VALUATION=
