# ─────────────────────────────────────────────────────────────────────────────
# CarMazium — frontend environment variables
#
# Copy to `.env.local` for local development. Everything prefixed
# NEXT_PUBLIC_ is inlined into the client bundle at build time and is
# therefore PUBLIC — never put a secret behind that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API
NEXT_PUBLIC_API_URL=https://carmazium-hjoh9w.fly.dev
# Optional websocket override; defaults to NEXT_PUBLIC_API_URL when blank.
NEXT_PUBLIC_WS_URL=

# Supabase (auth + image storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Analytics & advertising ─────────────────────────────────────────────────
# All of these are optional. Each component no-ops entirely when its ID is
# unset, and nothing loads at all until the visitor accepts analytics/marketing
# cookies (see context/ConsentContext.tsx).

# Google Analytics 4 — components/analytics/GoogleAnalytics.tsx
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager — components/analytics/GoogleTagManager.tsx
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta (Facebook) Pixel — components/analytics/MetaPixel.tsx
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel — components/analytics/TikTokPixel.tsx
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Google Ads conversion tracking ──────────────────────────────────────────
# The Ads account ID loads the tag; the labels below turn individual
# conversions on. See lib/googleAds.ts.
#
# WHERE TO FIND A LABEL: Google Ads → Goals → Conversions → Summary → click the
# conversion action → "Tag setup" → "Use Google Tag Manager" (or view the
# gtag snippet). You'll see a value like:
#
#     send_to: 'AW-18328618718/AbC-D_efG-h12_34-567'
#                              └─────────────────────┘
#                              only this part goes below
#
# Any label left unset simply disables that conversion — the app behaves
# identically until you fill it in, so you can enable them one at a time.

NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# The two live conversions already have their labels committed as defaults in
# lib/googleAds.ts (they're public values, not secrets), so these only need
# setting to OVERRIDE them — e.g. pointing a staging build at a test action.

# Primary money conversion. Fires on every cleared Stripe checkout (listing
# fee, HPI report, buyer fee…), carrying value/currency/transaction_id.
# Split by `fee_type` in reporting if you need per-product numbers.
NEXT_PUBLIC_GADS_LABEL_PURCHASE=

# Lead conversion. Seller finished the listing wizard, retail or auction.
NEXT_PUBLIC_GADS_LABEL_LISTING_SUBMITTED=

# Top-of-funnel micro-conversion. Reg entered and DVLA data came back.
# No Ads conversion action exists for this yet, so it is currently a no-op.
# If you create one, make it "Secondary" — a cheap top-funnel action set as
# Primary skews smart bidding towards low-intent traffic.
NEXT_PUBLIC_GADS_LABEL_VALUATION=
